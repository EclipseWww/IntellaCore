PORT=5003
MONGODB_URI=mongodb://127.0.0.1:27017/student-ai-chat
JWT_SECRET=replace-with-random-secret
MASTER_PASSWORD=replace-with-strong-password
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
MODEL=qwen-turbo
ALLOWED_ORIGINS=http://localhost:3000

# Python 服务器判题（需要 Node.js 22.13+；以下均为可选，括号内为默认值）
# PYTHON_JUDGE_WORKERS=2          # 同时判题的提交数（2）
# PYTHON_JUDGE_TIMEOUT_MS=5000    # 单个测试点超时毫秒数（5000）
# PYTHON_JUDGE_MEMORY_MB=512      # 单个判题进程的 Python 内存上限（512）
# PYTHON_JUDGE_MAX_QUEUE=200      # 排队上限，超出时提示学生稍后再交（200）
